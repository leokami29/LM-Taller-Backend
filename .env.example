# Base
DEBUG=False

# Database (local o Railway)
# Desde TU PC (Alembic, uvicorn local): usa la URL PÚBLICA del Postgres (Railway: DATABASE_PUBLIC_URL) + ?sslmode=require.
# NO uses host *.railway.internal desde fuera de Railway: no resuelve DNS en tu máquina.
# Ejemplo Railway desde PC:
# DATABASE_URL=postgresql://postgres:PASSWORD@xxxx.proxy.rlwy.net:PORT/railway?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Database-per-tenant (opcional; por defecto el monolito sigue con solo DATABASE_URL)
# USE_TENANT_DATABASE_ROUTING=false
#
# Obligatorio para migraciones del catálogo: alembic -c alembic_catalog.ini upgrade head
# Desde tu PC: misma regla que DATABASE_URL (pública + sslmode). Dentro de Railway puede ser la URL interna.
# CATALOG_DATABASE_URL=postgresql://postgres:PASSWORD@xxxx.proxy.rlwy.net:PORT/railway?sslmode=require
# Ejemplo mapa demo (UUIDs fijos en scripts/seed_demo_constants.py + URLs de tus 2 BDs tenant):
# TENANT_DATABASE_URL_MAP_JSON={"a0000000-0000-4000-8000-000000000001":"postgresql://...tenant_central...","a0000000-0000-4000-8000-000000000002":"postgresql://...tenant_norte..."}
# TENANT_ENGINE_CACHE_MAX=24
# TENANT_RESOLVER_CACHE_TTL_SEC=60
# Migraciones catálogo (desde carpeta Backend): alembic -c alembic_catalog.ini upgrade head

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
# Valores por defecto hasta que exista platform_config.json (editable en /platform/settings → Sesiones)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array or comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sgtaller
MINIO_USE_SSL=false

# SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sgtaller.com
