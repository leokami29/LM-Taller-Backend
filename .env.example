# Base
DEBUG=False

# Database (local o Railway: copia la URL pública del plugin Postgres en Railway)
# Ejemplo local:
# DATABASE_URL=postgresql://sgtaller:sgtaller_password@localhost:5432/sgtaller_db
# Ejemplo Railway (sustituye usuario, contraseña, host y puerto; suele requerir SSL):
# DATABASE_URL=postgresql://postgres:PASSWORD@xxxx.proxy.rlwy.net:PORT/railway?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Database-per-tenant (opcional; por defecto el monolito sigue con solo DATABASE_URL)
# USE_TENANT_DATABASE_ROUTING=false
# CATALOG_DATABASE_URL=postgresql://...   # control plane: tenant_routing + platform_users
# TENANT_DATABASE_URL_MAP_JSON={}         # JSON: {"<company-uuid>": "postgresql://...tenant..."}
# TENANT_ENGINE_CACHE_MAX=24
# TENANT_RESOLVER_CACHE_TTL_SEC=60
# Migraciones catálogo (desde carpeta Backend): alembic -c alembic_catalog.ini upgrade head

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array or comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sgtaller
MINIO_USE_SSL=false

# SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sgtaller.com
